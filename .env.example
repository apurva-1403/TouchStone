# Copy to .env for local development (.env is gitignored). Gemini is called through Vertex AI with
# Application Default Credentials (gcloud auth application-default login), so no API keys are needed.
GOOGLE_CLOUD_PROJECT=groovy-analyst-509819-d5
GOOGLE_CLOUD_LOCATION=global
AGENT_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Demo sign-in. Generate your own values; on Cloud Run these come from Secret Manager.
#   python -c "import secrets; print('algoworks-' + secrets.token_hex(3))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
